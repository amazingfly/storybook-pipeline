{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSON-driven storybook",
  "type": "object",
  "required": ["version", "title", "settings", "scenes"],
  "properties": {
    "version": {
      "const": "storybook-script-v2"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "settings": {
      "type": "object",
      "required": ["candidates_per_scene", "seed_start"],
      "properties": {
        "candidates_per_scene": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "seed_start": {
          "type": "integer",
          "minimum": 0
        },
        "resolution": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 512},
            {"type": "integer", "minimum": 512}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "pre_roll_seconds": {
          "type": "number",
          "minimum": 0
        },
        "post_roll_seconds": {
          "type": "number",
          "minimum": 0
        },
        "fps": {
          "type": "integer",
          "minimum": 12,
          "maximum": 60
        },
        "tts": {
          "type": "object",
          "properties": {
            "engine": {"const": "piper"},
            "voice": {"type": "string"},
            "length_scale": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene", "loras", "prompt", "script"],
        "properties": {
          "scene": {
            "type": "integer",
            "minimum": 1
          },
          "loras": {"$ref": "#/$defs/sceneLoras"},
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "script": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "loraReference": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "characterLoras": {
      "type": "object",
      "required": ["identity"],
      "properties": {
        "identity": {"$ref": "#/$defs/loraReference"},
        "outfit": {"$ref": "#/$defs/loraReference"}
      },
      "additionalProperties": {"$ref": "#/$defs/loraReference"},
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "sceneLoras": {
      "type": "object",
      "required": ["characters"],
      "properties": {
        "characters": {
          "type": "object",
          "minProperties": 0,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {"$ref": "#/$defs/characterLoras"}
        },
        "scene": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {"$ref": "#/$defs/loraReference"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
